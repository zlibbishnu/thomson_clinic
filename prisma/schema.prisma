model Doctor {
  id                   Int      @id @default(autoincrement())

  name                 String
  slug                 String   @unique

  qualification        String
  designation          String

  specialty            String
  subSpecialty         String?

  registrationNumber   String?
  experienceYears      Int?

  languages            String?
  areasOfExpertise     String?

  consultationMode     String?
  consultationFee      Int?

  location             String?
  availability         String?

  phone                String?
  email                String?
  website              String?
  photoUrl             String?

  bio                  String?
  additionalInformation String?

  isActive             Boolean  @default(true)

  createdAt            TimestamptzString @default(now())
  updatedAt            TimestamptzString @default(now())
}

model DoctorRegistration {
  id                   Int      @id @default(autoincrement())

  name                 String
  qualification        String
  designation          String

  specialty            String
  subSpecialty         String?

  registrationNumber   String?
  experienceYears      Int?

  languages            String?
  areasOfExpertise     String?

  consultationMode     String?
  consultationFee      Int?

  location             String?
  availability         String?

  phone                String?
  email                String?
  website              String?
  photoUrl             String?

  bio                  String?
  additionalInformation String?

  status               String   @default("PENDING")

  createdAt            TimestamptzString @default(now())
  updatedAt            TimestamptzString @default(now())
}